# ===================================================
# ABOCCRIM - Entorno de Desarrollo
# ===================================================

# Base de datos PostgreSQL
POSTGRES_DB=aboccrim_db
POSTGRES_USER=aboccrim_user
POSTGRES_PASSWORD=aboccrim_password
POSTGRES_PORT=5432

# Backend Django
DJANGO_SECRET_KEY=django-insecure-aboccrim-dev-secret-key-change-in-prod-2025
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
BACKEND_PORT=8000

# Semillas de desarrollo
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=Aboccrim2025!

# Frontend Vite
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1

# Configuración de Correo SMTP (Google Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=soporte.aboccrim@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion_google
DEFAULT_FROM_EMAIL=ABOCCRIM <soporte.aboccrim@gmail.com>
FRONTEND_URL=http://localhost:5173

# ===================================================
# Almacenamiento de Archivos (MinIO / S3 / GCP Cloud Storage)
# ===================================================
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=aboccrim-media
MINIO_SECURE=false

